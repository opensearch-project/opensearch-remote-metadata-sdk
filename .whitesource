{
  "scanSettings": {
    "configMode": "AUTO",
    "configExternalURL": "",
    "projectToken": "",
    "baseBranches": []
  },
  "scanSettingsSAST": {
    "enableScan": false,
    "scanPullRequests": false,
    "incrementalScan": true,
    "baseBranches": [],
    "snippetSize": 10
  },
  "checkRunSettings": {
    "vulnerableCheckRunConclusionLevel": "failure",
    "displayMode": "diff",
    "useMendCheckNames": true
  },
  "checkRunSettingsSAST": {
    "checkRunConclusionLevel": "failure",
    "severityThreshold": "high"
  },
  "issueSettings": {
    "minSeverityLevel": "LOW",
    "issueType": "DEPENDENCY"
  },
  "issueSettingsSAST": {
    "minSeverityLevel": "high",
    "issueType": "repo"
  },
  "remediateSettings": {
    "enableRenovate": true,
    "extends": [
      "config:base",
      ":gitSignOff",
      "github>whitesource/merge-confidence:beta"
    ],
    "addLabels": ["skip-changelog"],
    "packageRules": [
      {
        "description": "aws-database-encryption-sdk-dynamodb pins an exact aws-cryptographic-material-providers version. Update both together so the published POM never contains two versions, which fails downstream plugin builds using failOnVersionConflict.",
        "matchPackageNames": [
          "software.amazon.cryptography:aws-database-encryption-sdk-dynamodb",
          "software.amazon.cryptography:aws-cryptographic-material-providers"
        ],
        "groupName": "AWS Database Encryption SDK for DynamoDB",
        "separateMajorMinor": false
      }
    ],
    "workflowRules": {
      "enabled": true
    }
  },
   "imageSettings":{
       "imageTracing":{
           "enableImageTracingPR": false,
           "addRepositoryCoordinate": false,
           "addDockerfilePath": false,
           "addMendIdentifier": false
       }
   }
}
